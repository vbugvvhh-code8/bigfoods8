# Copy to .env.local (local) and set in Netlify > Site settings > Environment variables.
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site address for canonical links, share cards and sitemap (default https://bigfoods.app)
NEXT_PUBLIC_SITE_URL=https://bigfoods.app
